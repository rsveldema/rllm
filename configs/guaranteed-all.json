{
  "build_type": "release",
  "model_directory": "models-8",
  "layers": 8,
  "window_size": 32,
  "window_stride": 16,
  "learn_depth": 1,
  "strip_comments": false,
  "token_drop_probability": 0.0,
  "token_typo_probability": 0.0,
  "sources": [
    "training_data0:0.05",
    "curriculum/grammar:0.15",
    "curriculum/syntax:0.10",
    "curriculum/systems:0.10",
    "curriculum/comments:0.10",
    "curriculum/algos:0.10",
    "curriculum/english:0.10",
    "curriculum/large:0.05",
    "training_data2:0.25"
  ],
  "cmake_arguments": [
    "-DDEBUG_ATTENTION_DIAGNOSTICS=OFF",
    "-DRLLM_ENABLE_STATISTICS=OFF",
    "-DRLLM_MAX_POSITION=512",
    "-DRLLM_MAX_ATTENTION_POSITION=32"
  ],
  "training_arguments": [
    "--epochs", "40",
    "--disable-example-convergence",
    "--disable-training-diagnostics",
    "--checkpoint-interval", "1800",
    "--validation-interval", "1800",
    "--learning-rate", "0.00001",
    "--layer-learning-rate-multiplier", "1.05",
    "--warmup-percent", "1",
    "--weight-initializer", "xavier-input-projections",
    "--ffn-initializer", "xavier-input-projections",
    "--embedding-initializer", "legacy-uniform",
    "--concept-embeddings", "configs/programming-concepts.json",
    "--learning-rate-schedule", "lowering",
    "--filter", "training_data0",
    "--filter", "curriculum/grammar",
    "--filter", "curriculum/syntax",
    "--filter", "curriculum/systems",
    "--filter", "curriculum/comments",
    "--filter", "curriculum/algos",
    "--filter", "curriculum/english",
    "--filter", "curriculum/large",
    "--micro-batch-size", "16",
    "--max-validation-windows", "512",
    "--validation-worst-count", "100",
    "--vulkan-device", "R9700",
    "--all-blocks-read-write",
    "--reset-training-cursor",
    "--restart-learning-rate-schedule",
    "--disable-early-stopping"
  ]
}
