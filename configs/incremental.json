{
  "build_type": "release",
  "model_directory": "models-8-incremental",
  "layers": 8,
  "window_size": 96,
  "window_stride": 48,
  "learn_depth": 1,
  "incremental_window": true,
  "incremental_stage_epochs": 4,
  "incremental_new_block_epochs": 2,
  "incremental_upgrade_output_scale": 0.1,
  "strip_comments": true,
  "sources": [
    "training_data0:0.05",
    "curriculum/grammar:0.15",
    "curriculum/syntax:0.10",
    "curriculum/systems:0.10"
  ],
  "cmake_arguments": [
    "-DDEBUG_ATTENTION_DIAGNOSTICS=OFF",
    "-DRLLM_ENABLE_STATISTICS=OFF",
    "-DRLLM_MAX_POSITION=256"
  ],
  "training_arguments": [
    "--epochs", "40",
    "--disable-example-convergence",
    "--checkpoint-interval", "3600",
    "--validation-interval", "900",
    "--learning-rate", "0.00001",
    "--layer-learning-rate-multiplier", "1.05",
    "--warmup-percent", "1",
    "--weight-initializer", "xavier-uniform",
    "--ffn-initializer", "xavier-uniform",
    "--embedding-initializer", "legacy-uniform",
    "--learning-rate-schedule", "lowering",
    "--micro-batch-size", "256",
    "--max-validation-windows", "512",
    "--validation-worst-count", "20",
    "--vulkan-device", "R9700"
  ]
}
