{
  "build_type": "release",
  "model_directory": "models-guaranteed-90",
  "layers": 8,
  "window_size": 32,
  "window_stride": 1,
  "learn_depth": 2,
  "strip_comments": true,
  "token_drop_probability": 0.0,
  "token_typo_probability": 0.0,
  "sources": [
    "curriculum/guaranteed-90:1.0"
  ],
  "cmake_arguments": [
    "-DDEBUG_ATTENTION_DIAGNOSTICS=OFF",
    "-DRLLM_ENABLE_STATISTICS=OFF",
    "-DRLLM_MAX_POSITION=512",
    "-DRLLM_MAX_ATTENTION_POSITION=32"
  ],
  "training_arguments": [
    "--epochs", "140",
    "--disable-example-convergence",
    "--disable-training-diagnostics",
    "--checkpoint-interval", "300",
    "--validation-interval", "300",
    "--learning-rate", "0.000005",
    "--layer-learning-rate-multiplier", "1.05",
    "--warmup-percent", "10",
    "--weight-initializer", "xavier-uniform",
    "--ffn-initializer", "xavier-uniform",
    "--embedding-initializer", "legacy-uniform",
    "--learning-rate-schedule", "lowering",
    "--micro-batch-size", "16",
    "--max-validation-windows", "512",
    "--validation-worst-count", "20",
    "--memorization-target-percent", "90",
    "--memorization-max-regression-percent", "20",
    "--disable-early-stopping",
    "--restart-learning-rate-schedule"
  ]
}
